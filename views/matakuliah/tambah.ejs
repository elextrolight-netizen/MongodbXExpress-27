<%- include('../partials/header') %>
<div class="container">
  <h1>Tambah Matakuliah</h1>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <div class="form-card">
    <form action="/matakuliah/tambah" method="POST">
      <div class="form-group">
        <label>Nama Matakuliah</label>
        <input type="text" name="nama_mk" placeholder="Contoh: Struktur Data" required />
      </div>
      <div class="form-group">
        <label>Pengajar</label>
        <input type="text" name="pengajar" placeholder="Nama dosen pengajar" required />
      </div>
      <div style="display:flex;gap:10px;margin-top:8px">
        <button type="submit" class="btn btn-primary">Simpan</button>
        <a href="/matakuliah" class="btn btn-danger">Batal</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
