<%- include('../partials/header') %>
<div class="container">
  <div class="top-bar">
    <h1>Data Matakuliah <span class="badge"><%= data.length %> matakuliah</span></h1>
    <a href="/matakuliah/tambah" class="btn btn-success">+ Tambah Matakuliah</a>
  </div>

  <% if (pesan) { %>
    <div class="alert alert-success"><%= pesan %></div>
  <% } %>

  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Nama Matakuliah</th>
        <th>Pengajar</th>
        <th>Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% data.forEach((mk, i) => { %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= mk.nama_mk %></td>
        <td><%= mk.pengajar %></td>
        <td>
          <a href="/matakuliah/edit/<%= mk._id %>" class="btn btn-warning">Edit</a>
          <form action="/matakuliah/hapus/<%= mk._id %>" method="POST" style="display:inline" onsubmit="return confirm('Hapus matakuliah ini?')">
            <button type="submit" class="btn btn-danger">Hapus</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (data.length === 0) { %>
      <tr><td colspan="4" style="text-align:center;color:#aaa;padding:24px">Belum ada data matakuliah</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
