<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Kampus Arvin</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #e7f5ff; color: #1e3a5f; }

    nav {
      background: #87ccf7;
      padding: 14px 30px;
      display: flex;
      align-items: center;
      gap: 24px;
    }
    nav a {
      color: #0d3a57;
      text-decoration: none;
      font-weight: 600;
      font-size: 15px;
      padding: 6px 14px;
      border-radius: 6px;
      transition: background 0.2s;
    }
    nav a:hover, nav a.active { background: #67b8e6; }
    nav .brand { font-size: 20px; font-weight: 700; margin-right: auto; color: #0d3a57; }

    .container { max-width: 960px; margin: 32px auto; padding: 0 20px; }

    h1 { font-size: 24px; margin-bottom: 20px; color: #0d3a57; }

    table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    th { background: #87ccf7; color: #0d3a57; padding: 12px 16px; text-align: left; font-size: 14px; }
    td { padding: 11px 16px; border-bottom: 1px solid #d9eaf3; font-size: 14px; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #f0fbff; }

    .btn { display: inline-block; padding: 7px 16px; border-radius: 6px; font-size: 13px; font-weight: 600; text-decoration: none; border: none; cursor: pointer; transition: opacity 0.2s; }
    .btn:hover { opacity: 0.85; }
    .btn-primary { background: #42a5f5; color: #fff; }
    .btn-warning { background: #f9a825; color: #fff; }
    .btn-danger  { background: #c62828; color: #fff; }
    .btn-success { background: #2e7d32; color: #fff; }

    .form-card { background: #fff; border-radius: 10px; padding: 28px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); max-width: 500px; }
    .form-group { margin-bottom: 16px; }
    label { display: block; margin-bottom: 6px; font-size: 14px; font-weight: 600; color: #274760; }
    input[type=text], input[type=number] {
      width: 100%; padding: 9px 12px; border: 1px solid #b8dcee;
      border-radius: 6px; font-size: 14px; outline: none; transition: border 0.2s;
    }
    input:focus { border-color: #42a5f5; }
    small { color: #556b7a; font-size: 12px; }

    .alert { padding: 12px 16px; border-radius: 6px; margin-bottom: 18px; font-size: 14px; }
    .alert-success { background: #e3f2fd; color: #0d47a1; border: 1px solid #90caf9; }
    .alert-error   { background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; }

    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .badge { display: inline-block; background: #d6efff; color: #0d3a57; border-radius: 20px; padding: 2px 10px; font-size: 12px; font-weight: 600; }
  </style>
</head>
<body>
<nav>
  <span class="brand">Kampus Arvin</span>
  <a href="/mahasiswa" class="<%= page === 'mahasiswa' ? 'active' : '' %>">Mahasiswa</a>
  <a href="/dosen"     class="<%= page === 'dosen'     ? 'active' : '' %>">Dosen</a>
  <a href="/matakuliah" class="<%= page === 'matakuliah' ? 'active' : '' %>">Matakuliah</a>
</nav>
