<%- include('../partials/header') %>
<div class="container">
  <h1>Tambah Mahasiswa</h1>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <div class="form-card">
    <form action="/mahasiswa/tambah" method="POST">
      <div class="form-group">
        <label>NRP</label>
        <input type="text" name="nrp" placeholder="Contoh: 2301006" required />
      </div>
      <div class="form-group">
        <label>Nama</label>
        <input type="text" name="nama" placeholder="Nama lengkap" required />
      </div>
      <div class="form-group">
        <label>Mata Kuliah</label>
        <input type="text" name="mk" placeholder="Basis Data, Pemrograman Web" />
        <small>Pisahkan dengan koma jika lebih dari satu</small>
      </div>
      <div style="display:flex;gap:10px;margin-top:8px">
        <button type="submit" class="btn btn-primary">Simpan</button>
        <a href="/mahasiswa" class="btn btn-danger">Batal</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
